# Configuration API Backend Node.js + Simulateur Python
REACT_APP_API_URL=http://localhost:8080

# Configuration Socket.IO
REACT_APP_SOCKET_URL=http://localhost:8080

# Configuration Simulateur Python
REACT_APP_PYTHON_SIMULATOR_URL=http://localhost:5000

# Configuration OSRM pour routes dynamiques
REACT_APP_OSRM_URL=http://localhost:5000

# Configuration services externes (si nécessaire)
REACT_APP_WEATHER_API_KEY=your_weather_api_key_here
REACT_APP_TOMTOM_API_KEY=your_tomtom_api_key_here

# Mode développement vs production
REACT_APP_ENV=development
REACT_APP_IS_DEMO=false

# Configuration de debug
REACT_APP_DEBUG_MODE=true
REACT_APP_LOG_LEVEL=info

# Configuration mise à jour temps réel
REACT_APP_UPDATE_INTERVAL=5000
REACT_APP_SOCKET_TIMEOUT=10000
